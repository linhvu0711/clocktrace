#!/usr/bin/env bash
# Runs the CI gates before every push, in the same order as .github/workflows/ci.yml,
# and blocks the push when one fails. The GitHub workflow runs only by hand, so this
# hook is the check that keeps a red branch off GitHub.
# pnpm install turns it on (scripts/install-hooks.sh sets core.hooksPath).
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

# git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# A delete has an all-zero local sha; a push made only of deletes has nothing to check.
# The gates run on the checkout, so the checkout must be the pushed commit: every
# pushed sha is HEAD and the tree is clean. Otherwise the gates would test code
# that never reaches GitHub, such as an uncommitted fix or a forgotten file.
zero="0000000000000000000000000000000000000000"
head_sha="$(git rev-parse HEAD)"
has_commits=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue
  has_commits=1
  if [[ "$local_sha" != "$head_sha" ]]; then
    echo "pre-push: $local_ref is not the checked-out commit, push blocked"
    echo "pre-push: check it out first so the gates run on what is pushed"
    exit 1
  fi
done
[[ "$has_commits" == "1" ]] || exit 0

if [[ -n "$(git status --porcelain)" ]]; then
  echo "pre-push: the tree has uncommitted or untracked files, push blocked"
  echo "pre-push: commit or remove them so the gates run on what is pushed"
  exit 1
fi

for gate in lint build typecheck test; do
  echo "pre-push: pnpm $gate"
  if ! pnpm "$gate"; then
    echo "pre-push: pnpm $gate failed, push blocked"
    exit 1
  fi
done
echo "pre-push: all gates passed"
